Bootstrap: docker
From: python:3.12-slim

%labels
    org.opencontainers.image.title HealthAgentBench pathology family
    org.opencontainers.image.source https://github.com/microsoft/HealthAgentBench
    healthagentbench.commit ce89def2edf56f4a2ef068f37c8544bff944d5fc

%post
    set -eux
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates curl wget util-linux jq openslide-tools \
        libopenslide0 libgl1 libglib2.0-0
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir \
        imagecodecs \
        numpy \
        pillow \
        requests \
        tifffile \
        openslide-python
    mkdir -p \
        /workspace \
        /logs/verifier \
        /logs/artifacts \
        /data/slide/current

%environment
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    cd /workspace
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"
