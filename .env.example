# HealthAgentBench environment template
#
# Copy this file to `.env` at the repository root and fill only the values
# required by the selected task family. The real `.env` is gitignored.

# =============================================================================
# 1. Dataset access for short-lived Apptainer bootstrap processes
# =============================================================================

# PhysioNet credentials for xray_report_correction tasks.
# PHYSIONET_USER and PHYSIONET_PASSWORD are accepted aliases.
PN_USER=
PN_PASS=

# Hugging Face token for the gated CT-RATE dataset.
HF_TOKEN=

# Redivis API token for EHRSHOT-based ehr_event_modelling tasks.
REDIVIS_API_TOKEN=

# =============================================================================
# 2. X-ray report verifier credentials
# =============================================================================

# Configure either the OpenAI variables or the Azure OpenAI variables.
CHEXPROMPT_OPENAI_API_KEY=
CHEXPROMPT_OPENAI_BASE_URL='https://api.openai.com/v1'
# CHEXPROMPT_DEPLOYMENT=gpt-5.4

# CHEXPROMPT_AZURE_OPENAI_API_KEY=
# CHEXPROMPT_AZURE_OPENAI_ENDPOINT=
# CHEXPROMPT_AZURE_OPENAI_API_VERSION=
# CHEXPROMPT_DEPLOYMENT=gpt-5.4

# =============================================================================
# 3. Optional coding-agent credentials
# =============================================================================

# Claude subscription authentication.
# CLAUDE_CODE_OAUTH_TOKEN=

# Codex subscription authentication through the host auth file.
# CODEX_FORCE_AUTH_JSON=1

# API-based agent authentication and optional compatible endpoints.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
