Bootstrap: docker
From: python:3.12-slim

%labels
    org.opencontainers.image.title HealthAgentBench EHR-data-quality family
    org.opencontainers.image.source https://github.com/microsoft/HealthAgentBench
    healthagentbench.commit ce89def2edf56f4a2ef068f37c8544bff944d5fc

%post
    set -eux
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates curl wget util-linux
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir \
        pandas==3.0.1 \
        pyarrow==23.0.1 \
        duckdb==1.5.2 \
        numpy==2.4.2 \
        pyyaml==6.0.3
    mkdir -p /workspace/data /workspace/submission /logs/verifier

%environment
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    cd /workspace
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"
