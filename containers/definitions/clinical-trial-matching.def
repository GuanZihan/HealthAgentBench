Bootstrap: docker
From: python:3.12-slim

%labels
    org.opencontainers.image.title HealthAgentBench clinical-trial-matching family
    org.opencontainers.image.source https://github.com/microsoft/HealthAgentBench
    healthagentbench.commit ce89def2edf56f4a2ef068f37c8544bff944d5fc

%post
    set -eux
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates curl util-linux
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir \
        remotezip==0.12.3 \
        pyyaml==6.0.3 \
        filelock==3.18.0
    mkdir -p /workspace/data /workspace/submission /logs/verifier

%environment
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    cd /workspace
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"
